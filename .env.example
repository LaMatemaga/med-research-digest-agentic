# Anthropic API key — required for all Claude agents
# Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...

# NCBI API key — optional, raises PubMed rate limit from 3 to 10 requests/second
# Get yours at https://account.ncbi.nlm.nih.gov/settings/ (free registration)
NCBI_API_KEY=

# Telegram bot token — required for high-tier alert delivery
# Create a bot with @BotFather on Telegram, then paste the token it gives you
TELEGRAM_BOT_TOKEN=123456789:ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789

# Telegram chat ID — the chat (personal, group, or channel) the bot should post alerts to
# Message @BotFather's bot once, then check https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_CHAT_ID=123456789

# Optional: Telegraph (telegra.ph) pages for full alert text. Enabled by default, no signup;
# an anonymous account is created on first use and its token cached in data/seen_items.db.
# Pages are public to anyone with the link. Set false to send the full alert on Telegram only.
# TELEGRAPH_ENABLED=true
# TELEGRAPH_ACCESS_TOKEN=

# Optional — max Claude calls per pipeline stage running at once (default 4). Each call
# starts a Claude CLI process and, on MCP-enabled stages, an npx MCP server. Lower it on
# low-memory machines.
# MAX_CONCURRENT_CLAUDE_CALLS=4

